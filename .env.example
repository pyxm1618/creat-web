# Application environment: local | test | staging | production
APP_ENV=local
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creat_web

# VERCEL_ENV is a Vercel system variable. Do not override it manually.
# Mapping is fail-closed: development->local, preview->staging, production->production.

# Required in staging/production when authentication or commerce recovery is enabled.
BETTER_AUTH_SECRET=
CRON_SECRET=

# Email transport defaults to test in local/test and resend in staging/production.
# TEST_EMAIL_DIR is forbidden in staging and production.
EMAIL_TRANSPORT=test
TEST_EMAIL_DIR=/tmp/creat-web-test-emails
EMAIL_FROM=
SUPPORT_EMAIL=
RESEND_API_KEY=

# Google is optional and disabled in the neutral starter configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Waffo Pancake MoR is optional and commerce is disabled in the neutral starter.
# Never commit real merchant IDs, private keys, webhook keys, or retention keys.
# Deployed commerce additionally requires WAFFO_CONTRACT_VERIFIED=1 after live/test resource validation.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
WAFFO_CONTRACT_VERIFIED=0

# Base64 encoding of exactly 32 random bytes, plus a rotation identifier.
COMMERCE_RETENTION_KEY=
COMMERCE_RETENTION_KEY_ID=

# Analytics remains optional.
GA4_MEASUREMENT_ID=
