# Application environment: local | test | staging | production
APP_ENV=local
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creat_web

# Required in staging/production when authentication is enabled.
BETTER_AUTH_SECRET=

# Email transport defaults to test in local/test and resend in staging/production.
EMAIL_TRANSPORT=test
EMAIL_FROM=
SUPPORT_EMAIL=
RESEND_API_KEY=

# Google is optional and disabled in the neutral starter configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Other optional providers.
WAFFO_PRIVATE_KEY=
GA4_MEASUREMENT_ID=
