# Application environment: local | test | staging | production
APP_ENV=local
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creat_web

# VERCEL_ENV is a Vercel system variable. Do not override it manually.
# Mapping is fail-closed: development->local, preview->staging, production->production.

# Required in staging/production only when the corresponding feature needs them.
# The neutral SEO-only starter does not require Auth, Email, Commerce, or Analytics secrets.
BETTER_AUTH_SECRET=
CRON_SECRET=

# Email transport defaults to test in local/test and resend in staging/production when email is enabled.
# TEST_EMAIL_DIR is forbidden in staging and production.
EMAIL_TRANSPORT=test
TEST_EMAIL_DIR=/tmp/creat-web-test-emails
EMAIL_FROM=
SUPPORT_EMAIL=
RESEND_API_KEY=

# Google sign-in is optional and disabled in the neutral starter configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic Link abuse protection. Local/test automatically use Cloudflare's official always-pass
# Turnstile testing pair when these are blank. Staging/production require real keys and reject
# Cloudflare testing keys. Never expose TURNSTILE_SECRET_KEY to browser code.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Waffo Pancake MoR is optional and commerce is disabled in the neutral starter.
# Never commit real merchant IDs, private keys, webhook keys, or retention keys.
# Deployed commerce additionally requires WAFFO_CONTRACT_VERIFIED=1 after live/test resource validation.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
WAFFO_CONTRACT_VERIFIED=0

# Base64 encoding of exactly 32 random bytes, plus a rotation identifier.
COMMERCE_RETENTION_KEY=
COMMERCE_RETENTION_KEY_ID=

# Analytics providers are optional. IDs are parsed only when their feature flags are enabled.
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
